import importlib
import os
import re
import subprocess
import sys
from pathlib import Path

# Sphinx executes this file from the generated configuration directory
# ($(BUILDDIR)/doc), so the repository root is substituted as an absolute path
# by the docs Makefile rather than resolved relative to this file.
sys.path.insert(0, str(Path('${nccl:SourceRoot}/bindings/nccl4py').resolve()))

# -- Project information -----------------------------------------------------

project = u'NCCL'
copyright = u'2020-2026, NVIDIA Corporation'
author = u'NVIDIA Corporation'

version_long = u'${nccl:Major}.${nccl:Minor}.${nccl:Patch}'

version_short = u'${nccl:Major}.${nccl:Minor}'

version = str(version_short)
release = str(version_long)

# -- General configuration ---------------------------------------------------

# If your documentation needs a minimal Sphinx version, state it here.
#
# needs_sphinx = '1.0'

# Add any Sphinx extension module names here, as strings. They can be
# extensions coming with Sphinx (named 'sphinx.ext.*') or your custom
# ones.
extensions = [
    'sphinx.ext.autodoc',
    'sphinx.ext.intersphinx',
    'sphinx.ext.mathjax',
    'sphinx.ext.napoleon',
    'sphinx.ext.ifconfig',
    'sphinx.ext.extlinks',
    'myst_parser',
    'sphinx_llm.txt',
]

llms_txt_extension = 'sphinx_llm.txt'
try:
    importlib.import_module(llms_txt_extension)
except ImportError as exc:
    if os.environ.get('SKIP_LLMSTXT') == '1':
        extensions.pop(extensions.index(llms_txt_extension))
    else:
        raise RuntimeError(
            'sphinx-llm is required to generate llms.txt. Install it using docs/website/requirements.txt'
            ' or set SKIP_LLMSTXT=1 to build without generating llms.txt.'
        ) from exc

# Intersphinx mapping. cuda.core symbols (Buffer, Device, Stream,
# cuda.core.typing.IsStreamType) appear in nccl4py type annotations but
# cuda.core is mocked in autodoc_mock_imports, so they have no entry in
# our local Python domain. The intersphinx inventory provides those
# entries so python_use_unqualified_type_names can resolve them and
# render short names (`Buffer` instead of `cuda.core.Buffer`).
intersphinx_mapping = {
    'cuda-core': ('https://nvidia.github.io/cuda-python/cuda-core/latest/', None),
    'packaging': ('https://packaging.pypa.io/en/stable/', None),
}

# The suffix(es) of source filenames.
source_suffix = {
    '.rst': 'restructuredtext',
    '.md': 'markdown',
}

myst_enable_extensions = [
    'colon_fence',
    'attrs_block',
    'deflist',
]

# The master toctree document.
master_doc = 'index'

# The language for content autogenerated by Sphinx. Refer to documentation
# for a list of supported languages.
#
# This is also used if you do content translation via gettext catalogs.
# Usually you set "language" from the command line for these cases.
language = 'en-US'

# List of patterns, relative to source directory, that match files and
# directories to ignore when looking for source files.
# This pattern also affects html_static_path and html_extra_path.
exclude_patterns = [
    u'_build', 'Thumbs.db', '.DS_Store', '**.ipynb_checkpoints',
    '.venv', 'README.md',
]

# Suppress duplicate C declaration warnings (rank/nRanks appear in multiple
# structs in the C API). autodoc warnings (mocked-object, import-failure)
# are intentionally NOT suppressed: they signal that a Python symbol cannot
# be introspected, which usually means a missing dependency or a broken
# install -- both worth surfacing during the build.
suppress_warnings = ['c.duplicated']

# The name of the Pygments (syntax highlighting) style to use.
pygments_style = 'sphinx'
highlight_language = 'c++'

# -- Autodoc / Napoleon configuration ----------------------------------------
# Used by the nccl4py (Python) API reference. The C-side rst pages remain
# hand-written with .. c:function:: directives.

autodoc_mock_imports = [
    'cupy',
    'torch',
    'cuda',
    'numpy',
    'packaging',
    'nccl.bindings',
]

# Default options applied to every autodoc directive unless overridden.
# Members are opt-in: rst pages add `:members:` explicitly on classes whose
# methods/properties should be documented inline. The Communicator class
# documents each method as its own section instead, so it deliberately omits
# `:members:`.
autodoc_default_options = {
    'undoc-members': False,
    'show-inheritance': True,
    'member-order': 'bysource',
}

# Render type hints from the signature, not as a separate field.
autodoc_typehints = 'signature'

# Drop fully-qualified module prefixes from type-hint rendering. Without
# this, return types like `list[Communicator]` are rendered as
# `list[nccl.core.communicator.Communicator]` and `tuple[..., NcclDataType,
# ...]` becomes `tuple[..., nccl.core.typing.NcclDataType, ...]`. With it,
# Sphinx resolves the short name against the documented Python domain.
# Note: types from mocked modules (cuda.core, cuda.core.typing) still
# render fully-qualified because they have no Python-domain entry to
# resolve against.
python_use_unqualified_type_names = True

# Napoleon: Google-style docstrings (NumPy-style is disabled).
napoleon_google_docstring = True
napoleon_numpy_docstring = False
napoleon_include_init_with_doc = False
napoleon_include_private_with_doc = False
napoleon_include_special_with_doc = False
napoleon_use_admonition_for_notes = False
napoleon_use_admonition_for_examples = False
napoleon_use_admonition_for_references = False
napoleon_use_ivar = False
napoleon_use_param = True
napoleon_use_rtype = False
# Disabled so dataclass-style classes (e.g. WaitSignalDesc) don't render a
# redundant `Type: int` block under each Attributes entry. The constructor
# signature already shows the same type info.
napoleon_attr_annotations = False


